# Base URL of the FastAPI service, used by server-side fetches.
API_BASE_URL=http://127.0.0.1:8000

# Public origin of the web app (canonical URL, sitemap, Open Graph). Falls back to the provisional
# Vercel domain when unset; set it on the day the custom domain exists (decision D3).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
