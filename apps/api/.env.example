APP_ENV=development
LOG_LEVEL=INFO
# Required from Phase 2 onward. Example (Neon): postgresql+psycopg://user:password@host/db?sslmode=require
DATABASE_URL=
# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:3000"]
# Auth (decision D3). Required (>= 32 chars) in production; a dev-only default is used otherwise.
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Must be true in production (the API refuses to start otherwise). COOKIE_DOMAIN only when app and
# API are on different subdomains.
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Public URL of the web app, used in e-mail links.
APP_BASE_URL=http://localhost:3000
# console | capture (tests) | smtp | disabled (beta mode, see BETA_NO_EMAIL_NO_FILES). Production requires smtp (any provider's relay; vendor is
# decision D11). SMTP_SECURITY: starttls (587, default) | ssl (465) | none (local relay).
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM="Compliance OS <no-reply@example.com>"
SMTP_SECURITY=starttls
SMTP_TIMEOUT_SECONDS=10
# Evidence and document files (decisions D9/D12): local | s3 (any S3-compatible store; provider and
# region are decision D12). With s3, credentials may also come from the platform (boto3 chain).
STORAGE_BACKEND=local
# Deployment switches (decision D17, docs/deploy.md): read X-Forwarded-For for per-IP limits;
# migrate + seed on process start (serverless); allow disabled e-mail/storage in production.
TRUST_PROXY_HEADERS=false
MIGRATE_ON_STARTUP=false
BETA_NO_EMAIL_NO_FILES=false
STORAGE_LOCAL_ROOT=.storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_KEY_PREFIX=
EVIDENCE_MAX_BYTES=10485760
# Calendar day for "overdue" and document validity; documents expiring within this many days are "vencendo".
DEFAULT_TIMEZONE=America/Sao_Paulo
DOCUMENT_EXPIRING_DAYS=30
# Document-expiry digest (scripts/send_reminders.py): at most one e-mail per organization every N days.
REMINDER_INTERVAL_DAYS=7

# Compliance Agent language model (decision D35). "none" keeps the deterministic agent only.
# "anthropic" enables free-text questions and per-risk explanations (docs/ai.md).
LLM_PROVIDER=none
# ANTHROPIC_API_KEY=
# LLM_BASE_URL=   # only behind a gateway/proxy in front of the Anthropic API
# LLM_MODEL=claude-opus-5
# LLM_EFFORT=medium
# LLM_MAX_OUTPUT_TOKENS=2048
# LLM_TIMEOUT_SECONDS=45
# LLM_USER_MINUTE_LIMIT=6
# LLM_ORG_HOURLY_LIMIT=60
