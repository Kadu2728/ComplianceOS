APP_ENV=development
LOG_LEVEL=INFO
# Required from Phase 2 onward. Example (Neon): postgresql+psycopg://user:password@host/db?sslmode=require
DATABASE_URL=
# JSON list of allowed browser origins.
CORS_ORIGINS=["http://localhost:3000"]
# Auth (decision D3). Required (>= 32 chars) in production; a dev-only default is used otherwise.
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Must be true in production (the API refuses to start otherwise). COOKIE_DOMAIN only when app and
# API are on different subdomains.
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Public URL of the web app, used in e-mail links.
APP_BASE_URL=http://localhost:3000
# console | capture (tests). Production provider pending (decision D11).
EMAIL_PROVIDER=console
# Evidence files (decisions D9/D12). Local disk until an S3-compatible backend is chosen.
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=.storage
EVIDENCE_MAX_BYTES=10485760
# Calendar day for "overdue" and document validity; documents expiring within this many days are "vencendo".
DEFAULT_TIMEZONE=America/Sao_Paulo
DOCUMENT_EXPIRING_DAYS=30
